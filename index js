const express = require('express');
const cors = require('cors');
const app = express();

// Enable CORS
app.use(cors());

app.get('/manifest.json', (req, res) => {
  res.json({
    id: "org.snakeeyes.addon",
    version: "1.0.0",
    name: "Snakeeyes",
    resources: ["stream"],
    types: ["movie", "series"]
  });
});

app.get('/stream/:type/:id.json', async (req, res) => {
  try {
    const { type, id } = req.params;
    
    const response = await fetch('https://raw.githubusercontent.com/Tre9995/Snakeeyes-repo/main/sources.json');
    const data = await response.json();
    
    const sources = data[type === 'movie' ? 'movies' : 'series'];
    
    const streams = sources.map(source => ({
      name: source.name,
      title: source.name,
      url: source.url.replace('{imdb}', id),
      externalUrl: source.url.replace('{imdb}', id)
    }));
    
    res.json({ streams });
  } catch (error) {
    console.error('Error:', error);
    res.status(500).json({ error: error.message });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Snakeeyes addon running on http://localhost:${PORT}`);
});