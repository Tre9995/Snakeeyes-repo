{
  "id": "community.snakeeyes.movies",
  "version": "1.1.0",
  "name": "Snakeeyes - Movies & TV Shows",
  "description": "A comprehensive movie and TV shows addon with TMDB and OMDb API integration. Access metadata and legal streaming sources.",
  "types": ["movie", "series"],
  "resources": [
    {
      "name": "stream",
      "types": ["movie", "series"],
      "idPrefixes": ["tt"]
    },
    {
      "name": "meta",
      "types": ["movie", "series"],
      "idPrefixes": ["tt"]
    },
    {
      "name": "catalog",
      "types": ["movie", "series"]
    }
  ],
  "catalogs": [
    {
      "type": "movie",
      "id": "snakeeyes-movies",
      "name": "Snakeeyes Movies"
    },
    {
      "type": "series",
      "id": "snakeeyes-series",
      "name": "Snakeeyes Series"
    }
  ],
  "logo": "https://raw.githubusercontent.com/Tre9995/Snakeeyes-repo/main/logo.png",
  "background": "https://raw.githubusercontent.com/Tre9995/Snakeeyes-repo/main/background.png",
  "contactEmail": "support@snakeeyes.addon",
  "behaviorHints": {
    "configurable": true,
    "configurationRequired": false
  },
  "apiSources": [
    {
      "name": "TMDB (The Movie Database)",
      "id": "tmdb",
      "url": "https://www.themoviedb.org",
      "type": "both",
      "requiresApiKey": true,
      "apiKeyUrl": "https://www.themoviedb.org/settings/api"
    },
    {
      "name": "OMDb API",
      "id": "omdb",
      "url": "http://www.omdbapi.com",
      "type": "both",
      "requiresApiKey": true,
      "apiKeyUrl": "http://www.omdbapi.com/apikey.aspx"
    }
  ],
  "freeSources": [
    {
      "name": "YouTube",
      "id": "youtube",
      "url": "https://www.youtube.com",
      "type": "both"
    },
    {
      "name": "Tubi TV",
      "id": "tubi",
      "url": "https://tubitv.com",
      "type": "both"
    },
    {
      "name": "Public Domain Movies",
      "id": "publicdomain",
      "url": "https://publicdomainmovies.info",
      "type": "movies"
    }
  ]
}
